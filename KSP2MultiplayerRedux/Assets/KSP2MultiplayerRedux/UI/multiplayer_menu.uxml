<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi="http://www.w3.org/2001/XMLSchema-instance"
    engine="UnityEngine.UIElements"
    editor="UnityEditor.UIElements"
    noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <!-- We use default Unity elements but they will inherit the KSP2 SpaceWarp app theme when loaded via UITK. -->
    <ui:VisualElement class="root" style="width: 500px; height: 450px; background-color: rgba(30, 30, 35, 0.95); border-radius: 8px; padding: 15px;">
        <ui:Label text="KSP2 MULTIPLAYER REDUX" style="font-size: 18px; -unity-font-style: bold; color: rgb(200, 200, 200); align-self: center; margin-bottom: 10px;" />
        
        <!-- Status Section -->
        <ui:VisualElement style="margin-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgb(80, 80, 80); padding-bottom: 10px; flex-direction: row; justify-content: space-between;">
            <ui:Label name="statusLabel" text="Status: DISCONNECTED" style="color: rgb(255, 80, 80); -unity-font-style: bold; align-self: center;" />
            <ui:ProgressBar name="transferProgress" value="0" high-value="100" style="width: 200px; display: none;" />
        </ui:VisualElement>

        <!-- Hosting & Joining Row -->
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px;">
            <ui:VisualElement style="flex-direction: row;">
                <ui:Label text="Join Game:" style="align-self: center; color: rgb(180, 180, 180); margin-right: 5px;" />
                <ui:TextField name="ipInput" value="127.0.0.1" style="width: 100px; margin-right: 5px;" />
                <ui:TextField name="portInput" value="7777" style="width: 50px; margin-right: 5px;" />
            </ui:VisualElement>
            <ui:Button name="joinButton" text="Connect" style="width: 90px; background-color: rgb(40, 200, 100); color: black;" />
        </ui:VisualElement>

        <!-- Admin Controls -->
        <ui:VisualElement name="adminPanel" style="flex-direction: row; justify-content: flex-end; margin-bottom: 10px; display: none;">
            <ui:Button name="uploadSaveButton" text="Admin: Upload Save" style="background-color: rgb(150, 50, 150); color: white;" />
        </ui:VisualElement>

        <!-- Log Window -->
        <ui:VisualElement style="flex-grow: 1; background-color: rgba(10, 10, 10, 0.8); border-radius: 4px; padding: 5px; margin-bottom: 10px;">
            <ui:ScrollView name="logScrollView" style="flex-grow: 1;">
                <ui:Label name="logText" text="Ready." style="color: rgb(180, 180, 180); font-size: 11px; white-space: normal;" />
            </ui:ScrollView>
        </ui:VisualElement>
        
        <ui:Button name="disconnectButton" text="Disconnect" style="background-color: rgb(200, 50, 50); color: white;" />
    </ui:VisualElement>
</ui:UXML>
